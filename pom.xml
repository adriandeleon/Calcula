<?xml version="1.0" encoding="UTF-8"?>
<!--
  Calcula — reactor root.

  Two modules, and the split is load-bearing rather than cosmetic:

    calcula-app         modular (JPMS), jlink'd into the native image. Owns the CasEngine INTERFACE.
    calcula-cas-symja   plain non-modular jar. Owns the Symja IMPLEMENTATION, and is deliberately
                        NOT a dependency of calcula-app — it is discovered at runtime through a
                        URLClassLoader and lives on the classpath, never the module path.

  Why: matheclipse-core drags in 58 jars, of which only 9 carry a real module-info. Putting them on
  the module path means hand-writing ~49 moditect descriptors, including the Guava/jsr305 split-package
  mess and the commons-logging jar that jlink silently prunes. Loading them from a classpath directory
  sidesteps all of it — classpath classes live in the unnamed module, which needs no descriptors.

  It also happens to satisfy Symja's LGPL relink obligation in the cleanest available form: the jars
  sit in a plain directory the user can replace.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.calcula</groupId>
    <artifactId>calcula-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Calcula</name>
    <description>A keyboard-driven symbolic calculator in the spirit of Emacs Calc</description>
    <url>https://github.com/adriandeleon/Calcula</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>calcula-app</module>
        <module>calcula-cas-symja</module>
        <!-- LAST, and it has to stay last: it packages what the other two produce. -->
        <module>calcula-dist</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <javafx.version>26.0.1</javafx.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <junit.version>5.11.4</junit.version>
        <testfx.version>4.0.18</testfx.version>
        <!-- 0.8.13+ required: 0.8.12 cannot read class file major version 69 and dies on module-info.class. -->
        <jacoco.version>0.8.13</jacoco.version>
        <spotless.version>3.6.0</spotless.version>
        <palantir.version>2.92.0</palantir.version>
        <jpackage.plugin.version>1.6.6</jpackage.plugin.version>

        <!--
          Defaults for the dist profile, overridden per OS below. Declared here so that
          `mvn -Pdist package` on an unrecognised platform fails with a jpackage error naming the type,
          rather than with an unresolved-property error naming nothing.
        -->
        <jpackage.type>APP_IMAGE</jpackage.type>
        <jpackage.iconName>calcula.png</jpackage.iconName>
        <prism.pipeline>es2,sw</prism.pipeline>
        <jpackage.publicVersion>0.1.0</jpackage.publicVersion>
        <jpackage.appVersion>1.1.0</jpackage.appVersion>

        <!-- Latest RELEASE on Maven Central is 3.0.0 (Nov 2023); the GitHub project is active but
             publishes snapshots. Pin deliberately and re-check before a release. -->
        <matheclipse.version>3.0.0</matheclipse.version>

        <!--
          Where calcula-cas-symja stages its jars, and where the app looks for them in a dev run.

          Each module resolves this against its OWN basedir rather than a shared absolute path.
          ${maven.multiModuleProjectDirectory} looks like the reactor root and is not: without a .mvn
          marker directory it is simply wherever Maven was invoked from, so `mvn javafx:run` run from
          inside calcula-app/ produced calcula-app/calcula-app/target/cas and the engine silently went
          missing. Running from the root always worked, which is why it survived every check.
        -->
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <!-- Pinned: the default policy asks git for the platform's endings and answers CRLF on
                         Windows against an LF checkout, failing with a diff whose sides read identically. -->
                    <lineEndings>UNIX</lineEndings>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <removeUnusedImports/>
                        <palantirJavaFormat>
                            <version>${palantir.version}</version>
                        </palantirJavaFormat>
                        <!-- Longest-prefix wins, so javafx is not swallowed by java. -->
                        <importOrder>
                            <order>java|javax,javafx,,\#</order>
                        </importOrder>
                        <toggleOffOn/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>check</goal></goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      Per-OS packaging. There is no cross-building: jpackage and JavaFX are both host-specific, so each
      OS builds its own installer and the release workflow is a matrix rather than one job.

      Each profile computes two version numbers, and the difference between them matters:

        jpackage.publicVersion  the TRUE version — ${project.version} minus -SNAPSHOT
        jpackage.appVersion     what jpackage is actually handed

      They differ only on macOS, where jpackage refuses a version whose first number is zero — so a
      0.1.0 project cannot be packaged at all without a bumped placeholder. The placeholder is bundle
      metadata only, and aot_build.java rewrites Info.plist back to the true version before the DMG
      wrap, so it never reaches a user's Get Info panel.
    -->
    <profiles>
        <profile>
            <id>os-mac</id>
            <activation><os><family>mac</family></os></activation>
            <properties>
                <jpackage.type>DMG</jpackage.type>
                <jpackage.iconName>calcula.icns</jpackage.iconName>
                <!-- JavaFX 26's Metal pipeline, which fixes the es2/OpenGL render-to-texture glitches on
                     Apple silicon. es2 and sw remain as fallbacks. -->
                <prism.pipeline>mtl,es2,sw</prism.pipeline>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>mac-jpackage-versions</id>
                                <phase>initialize</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <exportAntProperties>true</exportAntProperties>
                                    <target>
                                        <loadresource property="jpackage.publicVersion">
                                            <propertyresource name="project.version"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="-SNAPSHOT$" replace="" flags="gi"/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <!-- 0.1.0 -> 1.1.0. Bundle metadata only; rewritten back before the wrap. -->
                                        <loadresource property="jpackage.appVersion">
                                            <propertyresource name="jpackage.publicVersion"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="^0\." replace="1." flags="g"/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>os-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <properties>
                <jpackage.type>DEB</jpackage.type>
                <jpackage.iconName>calcula.png</jpackage.iconName>
                <prism.pipeline>es2,sw</prism.pipeline>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>linux-jpackage-versions</id>
                                <phase>initialize</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <exportAntProperties>true</exportAntProperties>
                                    <target>
                                        <loadresource property="jpackage.publicVersion">
                                            <propertyresource name="project.version"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="-SNAPSHOT$" replace="" flags="gi"/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <!-- Linux accepts a leading 0., so the two are the same number. -->
                                        <property name="jpackage.appVersion" value="${jpackage.publicVersion}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>os-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties>
                <jpackage.type>MSI</jpackage.type>
                <jpackage.iconName>calcula.ico</jpackage.iconName>
                <!-- Must keep d3d: a blanket mtl,es2,sw would strip Direct3D and lose GPU acceleration. -->
                <prism.pipeline>d3d,es2,sw</prism.pipeline>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>windows-jpackage-versions</id>
                                <phase>initialize</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <exportAntProperties>true</exportAntProperties>
                                    <target>
                                        <loadresource property="jpackage.publicVersion">
                                            <propertyresource name="project.version"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="-SNAPSHOT$" replace="" flags="gi"/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <property name="jpackage.appVersion" value="${jpackage.publicVersion}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
